    "keywords": [
        "recipe",
        "Varbase recipes",
        "Drupal recipes",
        "Varbase AI",
        "Drupal AI",
        "AI Search",
        "vector database",
        "MariaDB",
        "RAG"
    ],
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/Vardot/varbase_ai_vdb_mariadb",
    "authors": [
        {
            "name": "Vardot",
            "homepage": "https://www.vardot.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/Vardot/varbase_ai_vdb_mariadb/issues",
        "source": "https://github.com/Vardot/varbase_ai_vdb_mariadb"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "drupal/ai": "^1.4",
        "drupal/ai_vdb_provider_mariadb": "^1.0",
        "drupal/core": "^11.4",
        "drupal/search_api": "^1.40"
    }
}
